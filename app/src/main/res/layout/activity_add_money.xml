<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/aba_background"
    android:orientation="vertical">

    <!-- Header -->
    <View
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:background="@color/aba_primary" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="-60dp"
        android:gravity="center"
        android:text="Add Money"
        android:textColor="@color/white"
        android:textSize="20sp"
        android:textStyle="bold" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"
                android:text="Select Method"
                android:textColor="@color/aba_text_secondary" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/white">

                <RadioGroup
                    android:id="@+id/radio_group_deposit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    
                    <RadioButton
                        android:id="@+id/radio_bank_transfer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Bank Transfer"
                        android:checked="true" />
                    
                    <RadioButton
                        android:id="@+id/radio_cash_deposit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Cash Deposit" />
                        
                    <RadioButton
                        android:id="@+id/radio_card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Debit/Credit Card" />
                </RadioGroup>
            </androidx.cardview.widget.CardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp"
                android:text="Amount to Add ($)"
                android:textColor="@color/aba_text_secondary" />

            <EditText
                android:id="@+id/amount_to_add"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:background="@drawable/rounded_bg_cyan"
                android:backgroundTint="#FFFFFF"
                android:hint="0.00"
                android:inputType="numberDecimal"
                android:paddingHorizontal="16dp"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/aba_primary_dark" />

            <Button
                android:id="@+id/btn_confirm_add_money"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="32dp"
                android:backgroundTint="@color/aba_primary"
                android:text="Confirm Deposit"
                android:textColor="@color/white"
                android:textSize="18sp"
                app:cornerRadius="12dp" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>