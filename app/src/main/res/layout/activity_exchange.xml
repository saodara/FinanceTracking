<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/aba_background"
    android:orientation="vertical">

    <!-- Header -->
    <View
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:background="@color/aba_primary" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="-60dp"
        android:gravity="center"
        android:text="Currency Exchange"
        android:textColor="@color/white"
        android:textSize="20sp"
        android:textStyle="bold" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- From -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"
                android:text="From Currency"
                android:textColor="@color/aba_text_secondary" />

            <Spinner
                android:id="@+id/spinner_from_currency"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/rounded_bg_cyan"
                android:backgroundTint="#FFFFFF"
                android:paddingHorizontal="16dp" />

            <!-- To -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"
                android:text="To Currency"
                android:textColor="@color/aba_text_secondary" />

            <Spinner
                android:id="@+id/spinner_to_currency"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/rounded_bg_cyan"
                android:backgroundTint="#FFFFFF"
                android:paddingHorizontal="16dp" />

            <!-- Amount -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp"
                android:text="Amount to Sell"
                android:textColor="@color/aba_text_secondary" />

            <EditText
                android:id="@+id/exchange_amount_input"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:background="@drawable/rounded_bg_cyan"
                android:backgroundTint="#FFFFFF"
                android:hint="0.00"
                android:inputType="numberDecimal"
                android:paddingHorizontal="16dp"
                android:textSize="20sp" />

            <!-- Result -->
            <TextView
                android:id="@+id/exchange_result_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:text="You will receive: $0.00"
                android:textColor="@color/aba_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_confirm_exchange"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="32dp"
                android:backgroundTint="@color/aba_primary"
                android:text="Exchange Now"
                android:textColor="@color/white"
                android:textSize="18sp"
                app:cornerRadius="12dp" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>