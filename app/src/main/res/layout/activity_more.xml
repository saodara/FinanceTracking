<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/aba_background"
    android:orientation="vertical">

    <View
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:background="@color/aba_primary" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="-60dp"
        android:gravity="center"
        android:text="More Options"
        android:textColor="@color/white"
        android:textSize="20sp"
        android:textStyle="bold" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="General"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"
                android:textColor="@color/aba_primary"
                android:textStyle="bold"/>

            <Button
                android:id="@+id/btn_locations"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="Locate Us"
                android:gravity="start|center_vertical"
                android:drawableEnd="@android:drawable/ic_dialog_map"
                android:textColor="@color/aba_text_primary"/>

            <Button
                android:id="@+id/btn_contact"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="Contact Us"
                android:gravity="start|center_vertical"
                android:drawableEnd="@android:drawable/ic_menu_call"
                android:textColor="@color/aba_text_primary"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Information"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp"
                android:textColor="@color/aba_primary"
                android:textStyle="bold"/>

            <Button
                android:id="@+id/btn_terms"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="Terms &amp; Conditions"
                android:gravity="start|center_vertical"
                android:drawableEnd="@android:drawable/ic_menu_info_details"
                android:textColor="@color/aba_text_primary"/>

            <Button
                android:id="@+id/btn_privacy"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="Privacy Policy"
                android:gravity="start|center_vertical"
                android:drawableEnd="@android:drawable/ic_menu_view"
                android:textColor="@color/aba_text_primary"/>

        </LinearLayout>
    </ScrollView>
</LinearLayout>