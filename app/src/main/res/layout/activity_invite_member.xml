<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/aba_background"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Invite Member"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/aba_primary"
        android:layout_marginBottom="24dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Email Address"
        android:textColor="@color/aba_text_secondary"
        android:layout_marginBottom="8dp"/>

    <EditText
        android:id="@+id/invite_email"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/rounded_bg_cyan"
        android:backgroundTint="#FFFFFF"
        android:hint="family@example.com"
        android:inputType="textEmailAddress"
        android:paddingHorizontal="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Assign Role"
        android:textColor="@color/aba_text_secondary"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="8dp"/>

    <Spinner
        android:id="@+id/role_spinner"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/rounded_bg_cyan"
        android:backgroundTint="#FFFFFF" />

    <Button
        android:id="@+id/btn_send_invite"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="32dp"
        android:backgroundTint="@color/aba_primary"
        android:text="Send Invitation"
        android:textColor="@color/white"
        app:cornerRadius="12dp" />

</LinearLayout>